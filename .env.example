# Tên miền đã trỏ về VPS
DOMAIN=avenor.moclinh.vn
# Cho phép tạo thêm tài khoản sau tài khoản đầu tiên (1 = cho phép)
ALLOW_SIGNUP=0
# Strava API app (https://www.strava.com/settings/api), Authorization Callback Domain = DOMAIN
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Đăng nhập bằng Google (https://console.cloud.google.com/apis/credentials, OAuth client "Web application",
# Authorized redirect URI = https://DOMAIN/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Danh sách email Google được phép vào, cách nhau bằng dấu phẩy
ALLOWED_EMAILS=

# Chép lời ý tưởng (Whisper chạy trên VPS): tiny | base | small | medium. small cần ~1 GB RAM.
WHISPER_MODEL=small

# Trợ lý AI (Daily Briefing, Life Command): khóa Claude API, đặt bằng: bash deploy/set-ai.sh
ANTHROPIC_API_KEY=
# Model Claude (mặc định claude-opus-5-5; rẻ hơn: claude-sonnet-5-5, claude-haiku-5-5)
AI_MODEL=
# Số lần gọi AI tối đa mỗi ngày cho mỗi tài khoản
AI_DAILY_LIMIT=40

# Báo đơn tranh mới từ trucchi.moclinh.vn: khóa bí mật chung (>= 16 ký tự, giống AVENOR_WEBHOOK_SECRET bên trucchi)
TRUCCHI_WEBHOOK_SECRET=
# Tài khoản nhận thông báo (tên đăng nhập hoặc email, cách nhau dấu phẩy); để trống = tài khoản đầu tiên
TRUCCHI_NOTIFY_USERS=

# ---------- Business (doanh số, quảng cáo, website, kênh) — đặt bằng: bash deploy/set-business.sh ----------
# Tài khoản Avenor được xem Business (tên đăng nhập hoặc email, cách nhau dấu phẩy); để trống = tài khoản đầu tiên
BUSINESS_USERS=
# Sales: thư mục trên VPS chứa ketoan.db (bảng đơn tt_don), gắn vào container ở /sales, chỉ đọc
SALES_DATA_DIR=/opt/sothuchi/data
SALES_URL=https://sales.moclinh.vn/
# Trạng thái đơn KHÔNG tính doanh số (cách nhau dấu phẩy)
SALES_EXCLUDE=canceled,returned,returning,removed
# Google (Ads, GA4, YouTube): OAuth client "Web application", redirect URI https://DOMAIN/api/business/oauth/google/callback
BIZ_GOOGLE_CLIENT_ID=
BIZ_GOOGLE_CLIENT_SECRET=
# Google Ads: developer token (Google Ads → Tools → API Center); MCC id nếu truy cập qua tài khoản quản lý
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Meta Ads: app (Facebook Login, quyền ads_read, redirect https://DOMAIN/api/business/oauth/meta/callback) hoặc token System User có ads_read
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
# TikTok: app Login Kit + Display API (scope user.info.basic, user.info.profile, user.info.stats, video.list), redirect https://DOMAIN/api/business/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
